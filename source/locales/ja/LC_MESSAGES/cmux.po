msgid "cmux"
msgstr "cmux"

msgid ""
"Default shortcuts of cmux 0.65.2 (113). See `Keyboard Shortcuts "
"<https://cmux.com/docs/keyboard-shortcuts>`_ for the full list."
msgstr ""
"cmux 0.65.2 (113) の既定のショートカット。すべての一覧は `キーボードショートカット "
"<https://cmux.com/ja/docs/keyboard-shortcuts>`_ を参照"

msgid "App"
msgstr "アプリ"

msgid "settings"
msgstr "設定"

msgid "reload configuration"
msgstr "構成を再読み込み"

msgid "show/hide all cmux windows (system-wide hotkey)"
msgstr "すべての cmux ウインドウを表示/非表示（システム全体のホットキー）"

msgid "global search (when cmux is active)"
msgstr "グローバル検索（cmux が前面にあるとき）"

msgid "command palette"
msgstr "コマンドパレット"

msgid "show agent inbox"
msgstr "エージェント受信トレイを表示"

msgid "command palette next result (in the command palette)"
msgstr "コマンドパレットの次の結果（コマンドパレット内）"

msgid "command palette previous result (in the command palette)"
msgstr "コマンドパレットの前の結果（コマンドパレット内）"

msgid "new window"
msgstr "新規ウインドウ"

msgid "close window"
msgstr "ウインドウを閉じる"

msgid "toggle full screen"
msgstr "フルスクリーンを切り替え"

msgid "reopen previous session"
msgstr "前回のセッションを再度開く"

msgid "quit cmux"
msgstr "cmux を終了"

msgid "Workspaces"
msgstr "ワークスペース"

msgid "toggle left sidebar"
msgstr "左サイドバーを切り替え"

msgid "toggle right sidebar"
msgstr "右サイドバーを切り替え"

msgid "new local workspace"
msgstr "新規ローカルワークスペース"

msgid "new browser workspace (the first surface is a browser pane)"
msgstr "新規ブラウザワークスペース（最初のサーフェスがブラウザペインになる）"

msgid "save current workspace layout as a template"
msgstr "現在のワークスペースレイアウトをテンプレートとして保存"

msgid "open folder"
msgstr "フォルダを開く"

msgid "go to workspace (workspace switcher)"
msgstr "ワークスペースへ移動（ワークスペーススイッチャー）"

msgid "next workspace"
msgstr "次のワークスペース"

msgid "previous workspace"
msgstr "前のワークスペース"

msgid "move workspace up"
msgstr "ワークスペースを上へ移動"

msgid "move workspace down"
msgstr "ワークスペースを下へ移動"

msgid "focus back (outside browser panes)"
msgstr "フォーカスを戻す（ブラウザペインの外）"

msgid "focus forward (outside browser panes)"
msgstr "フォーカスを進める（ブラウザペインの外）"

msgid "select workspace 1-8"
msgstr "ワークスペース 1-8 を選択"

msgid "select the last workspace"
msgstr "最後のワークスペースを選択"

msgid "rename workspace"
msgstr "ワークスペース名を変更"

msgid "edit workspace description"
msgstr "ワークスペースの説明を編集"

msgid "mark workspace as done"
msgstr "ワークスペースを完了にする"

msgid "cycle workspace status one lane forward"
msgstr "ワークスペースのステータスを 1 つ先へ切り替え"

msgid "new empty workspace group"
msgstr "空のワークスペースグループを作成"

msgid "group selected workspaces"
msgstr "選択したワークスペースをグループ化"

msgid "collapse or expand focused workspace group"
msgstr "フォーカス中のワークスペースグループを折りたたみ/展開"

msgid ""
"focus the workspace sidebar (↑/↓ select, Return or Esc goes back to the "
"terminal)"
msgstr "ワークスペースサイドバーにフォーカス（↑/↓ で選び、Return か Esc でターミナルに戻る）"

msgid "toggle right-sidebar focus"
msgstr "右サイドバーのフォーカスを切り替え"

msgid "close workspace"
msgstr "ワークスペースを閉じる"

msgid "Surfaces"
msgstr "サーフェス"

msgid "new surface"
msgstr "新規サーフェス"

msgid "next surface"
msgstr "次のサーフェス"

msgid "previous surface"
msgstr "前のサーフェス"

msgid "reorder surface left"
msgstr "サーフェスを左へ並べ替え"

msgid "reorder surface right"
msgstr "サーフェスを右へ並べ替え"

msgid "move surface to previous pane"
msgstr "サーフェスを前のペインへ移動"

msgid "move surface to next pane"
msgstr "サーフェスを次のペインへ移動"

msgid "move the surface to the pane in that direction"
msgstr "サーフェスをその方向のペインへ移動"

msgid "select surface 1-8"
msgstr "サーフェス 1-8 を選択"

msgid "select the last surface"
msgstr "最後のサーフェスを選択"

msgid "rename tab"
msgstr "タブ名を変更"

msgid "close tab"
msgstr "タブを閉じる"

msgid "close other tabs in pane"
msgstr "ペイン内の他のタブを閉じる"

msgid "reopen last closed"
msgstr "最後に閉じた項目を再度開く"

msgid "toggle terminal copy mode"
msgstr "ターミナルコピーモードを切り替え"

msgid "clear screen (keep scrollback)"
msgstr "画面をクリア（スクロールバックを保持）"

msgid "Split Panes"
msgstr "分割ペイン"

msgid "focus the pane in that direction"
msgstr "その方向のペインにフォーカス"

msgid "focus pane 1-8"
msgstr "ペイン 1-8 にフォーカス"

msgid "focus the last pane"
msgstr "最後のペインにフォーカス"

msgid "split right"
msgstr "右に分割"

msgid "split down"
msgstr "下に分割"

msgid "new pane with auto layout (retiles all panes)"
msgstr "新しいペイン（自動レイアウト）（すべてのペインを並べ直す）"

msgid "split browser right"
msgstr "右にブラウザ分割"

msgid "split browser down"
msgstr "下にブラウザ分割"

msgid "toggle pane zoom"
msgstr "ペインズームを切り替え"

msgid "increase font size for every terminal in the selected workspace"
msgstr "選択中のワークスペース内の全ターミナルのフォントサイズを大きくする"

msgid "decrease font size for every terminal in the selected workspace"
msgstr "選択中のワークスペース内の全ターミナルのフォントサイズを小さくする"

msgid "reset font size for every terminal in the selected workspace"
msgstr "選択中のワークスペース内の全ターミナルのフォントサイズをリセットする"

msgid "equalize split sizes"
msgstr "分割サイズを均等にする"

msgid "resize the pane left, right, up, or down"
msgstr "ペインのサイズを左、右、上、下に変える"

msgid "Browser"
msgstr "ブラウザ"

msgid "open browser"
msgstr "ブラウザを開く"

msgid "focus address bar"
msgstr "アドレスバーにフォーカス"

msgid "back (in a browser pane)"
msgstr "戻る（ブラウザペイン内）"

msgid "forward (in a browser pane)"
msgstr "進む（ブラウザペイン内）"

msgid "reload page (in a browser pane)"
msgstr "ページを再読み込み（ブラウザペイン内）"

msgid "hard refresh page (in a browser pane)"
msgstr "ページを強制再読み込み（ブラウザペイン内）"

msgid "zoom in"
msgstr "拡大"

msgid "zoom out"
msgstr "縮小"

msgid "actual size"
msgstr "実寸表示"

msgid "toggle browser developer tools"
msgstr "ブラウザ開発者ツールを切り替え"

msgid "show browser JavaScript console"
msgstr "ブラウザ JavaScript コンソールを表示"

msgid "enter browser focus mode (the page gets shortcuts first)"
msgstr "ブラウザフォーカスモードに入る（ページがショートカットを先に受け取る）"

msgid ""
"leave browser focus mode (press twice within 1.6 seconds; the first Esc "
"also reaches the page)"
msgstr "ブラウザフォーカスモードを抜ける（1.6 秒以内に 2 回押す。1 回目の Esc はページにも届く）"

msgid "toggle browser design mode (select and edit elements visually)"
msgstr "ブラウザデザインモードを切り替え（要素を選んで見た目のまま編集する）"

msgid "toggle React Grab (in a browser pane)"
msgstr "React Grab を切り替え（ブラウザペイン内）"

msgid "Find"
msgstr "検索"

msgid "find"
msgstr "検索"

msgid "find in directory"
msgstr "ディレクトリ内を検索"

msgid "find next"
msgstr "次を検索"

msgid "find previous"
msgstr "前を検索"

msgid "hide find bar"
msgstr "検索バーを隠す"

msgid "use selection for find"
msgstr "選択範囲で検索"

msgid "Notifications"
msgstr "通知"

msgid "show notifications"
msgstr "通知を表示"

msgid "jump to latest unread"
msgstr "最新の未読へ移動"

msgid "jump to the surface where you last sent an agent prompt"
msgstr "最後にエージェントへプロンプトを送ったサーフェスへ移動"

msgid "toggle current item unread state"
msgstr "現在の項目の未読状態を切り替え"

msgid "mark current item as oldest unread and jump to the next latest unread"
msgstr "現在の項目を最古の未読にして次の最新未読へ移動"

msgid "flash focused panel"
msgstr "フォーカス中のパネルをフラッシュ"

msgid "Copy and Paste"
msgstr "コピーと貼り付け"

msgid ""
"copy the selection to the clipboard (selecting alone does not copy; ``⌃ +"
" c`` stops the running command instead)"
msgstr "選択範囲をクリップボードにコピー（選んだだけではコピーされない。``⌃ + c`` はコピーではなく、実行中のコマンドを止める）"

msgid ""
"paste the last selection inside cmux (middle click does the same; other "
"apps cannot paste it)"
msgstr "最後に選んだ文字を cmux の中に貼り付け（中クリックでも同じ。ほかのアプリには貼れない）"

msgid ""
"select a word (``/`` and ``.`` do not split words, so a path such as "
"``src/todo.ts`` is one word)"
msgstr "1 語を選択（``/`` と ``.`` では区切らないので、``src/todo.ts`` のようなパスは 1 語になる）"

msgid "select a line"
msgstr "1 行を選択"

msgid ""
"select the whole output of one command (needs shell integration, which "
"cmux sets up for zsh)"
msgstr "1 つのコマンドの出力全体を選択（シェル統合が必要。zsh では cmux が設定する）"

msgid "select a rectangle, such as one column of a table"
msgstr "四角い範囲を選択（表の 1 列だけを選ぶときなど）"

msgid "extend or shrink the selection to the clicked point"
msgstr "選択範囲を、クリックした位置まで広げる、または縮める"

msgid "move the end of the selection (only while text is selected)"
msgstr "選択範囲の終わりを動かす（文字を選んでいるときだけ）"

msgid ""
"select with cmux inside apps that use the mouse, such as Claude Code, "
"vim, and tmux"
msgstr "Claude Code、vim、tmux のようにマウスを使うアプリの中で、cmux の選択を使う"

msgid "Claude Code"
msgstr "Claude Code"

msgid ""
"select text; it is copied to the clipboard when you release the mouse "
"button (Copy on select in /config)"
msgstr "文字を選択。マウスのボタンを離すとクリップボードにコピーされる（/config の Copy on select）"

msgid "copy the selection; with nothing selected, interrupt as usual"
msgstr "選択範囲をコピー。何も選んでいなければ、いつもどおり中断"

msgid ""
"write the whole conversation into the terminal as plain text, so cmux "
"selection and copy mode can reach it"
msgstr "会話全体をターミナルに通常の文字として書き出し、cmux の選択やコピーモードで扱えるようにする"

msgid "Copy Mode"
msgstr "コピーモード"

msgid "enter or leave copy mode"
msgstr "コピーモードに入る、または抜ける"

msgid "leave copy mode without copying"
msgstr "コピーせずにコピーモードを抜ける"

msgid "move left, down, up, or right (arrow keys also work)"
msgstr "左、下、上、右へ移動（矢印キーでも同じ）"

msgid "move to the start of the line"
msgstr "行の先頭へ移動"

msgid "move to the end of the line"
msgstr "行の末尾へ移動"

msgid "move to the top of the scrollback (``Home`` also works)"
msgstr "スクロールバックの先頭へ移動（``Home`` でも同じ）"

msgid "move to the bottom (``End`` also works)"
msgstr "末尾へ移動（``End`` でも同じ）"

msgid "move to the previous prompt"
msgstr "前のプロンプトへ移動"

msgid "move to the next prompt"
msgstr "次のプロンプトへ移動"

msgid "scroll half a page up or down"
msgstr "半ページ上または下へスクロール"

msgid "scroll a page up or down (``PageUp`` and ``PageDown`` also work)"
msgstr "1 ページ上または下へスクロール（``PageUp`` と ``PageDown`` でも同じ）"

msgid "scroll a line up or down"
msgstr "1 行上または下へスクロール"

msgid "repeat a motion (``5j`` moves down five lines)"
msgstr "移動を繰り返す（``5j`` で 5 行下へ）"

msgid "start selecting by character (press again to stop selecting)"
msgstr "文字単位で選択を始める（もう一度押すと選択をやめる）"

msgid "start selecting by line"
msgstr "行単位で選択を始める"

msgid "copy the selection and leave copy mode"
msgstr "選択範囲をコピーしてコピーモードを抜ける"

msgid ""
"copy the current line and leave copy mode when nothing is selected "
"(``3yy`` copies three lines)"
msgstr "何も選んでいないとき、カーソルのある行をコピーしてコピーモードを抜ける（``3yy`` で 3 行）"

msgid "same as ``y`` with a selection, otherwise same as ``yy``"
msgstr "選択中は ``y``、選択していなければ ``yy`` と同じ"

msgid "copy the selection and stay in copy mode"
msgstr "選択範囲をコピーし、コピーモードを続ける"

msgid "open the search bar"
msgstr "検索バーを開く"

msgid "move to the next or previous match"
msgstr "次または前の一致へ移動"

